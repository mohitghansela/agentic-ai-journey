## 8. Full Working Program

At the end of class today, we built a **full working program** that combines all the concepts we learned — system prompts, personas, and chain-of-thought — into one interactive AI assistant.

```python
from dotenv import load_dotenv
from openai import OpenAI

load_dotenv()
client = OpenAI()

# All personas we learned about today
PERSONAS = {
    "1": {
        "name": "Python Tutor",
        "prompt": """
            You are a friendly Python tutor for beginners.
            - Use simple language and real-world analogies.
            - Always include a short working code example.
            - End with an encouraging message.
        """
    },
    "2": {
        "name": "Code Reviewer",
        "prompt": """
            You are a senior software engineer doing code review.
            - Be direct and technical.
            - Point out bugs, bad practices, and improvements.
            - Suggest better alternatives with code.
        """
    },
    "3": {
        "name": "Interview Coach",
        "prompt": """
            You are a technical interview coach for software engineers.
            - Never give the answer directly.
            - Guide the user with hints and follow-up questions.
            - Evaluate their reasoning, not just the answer.
        """
    }
}


def select_persona():
    print("\n🤖 Select a Persona:")
    for key, value in PERSONAS.items():
        print(f"  [{key}] {value['name']}")
    choice = input("Enter number (default: 1): ").strip() or "1"
    return PERSONAS.get(choice, PERSONAS["1"])


def ask_ai(system_prompt: str, question: str, use_cot: bool) -> str:
    # Chain-of-Thought: append step-by-step instruction if user wants it
    if use_cot:
        question += "\n\nPlease think step-by-step before giving your final answer."

    response = client.chat.completions.create(
        model="gpt-4o-mini",
        messages=[
            {"role": "system", "content": system_prompt},
            {"role": "user", "content": question}
        ]
    )
    return response.choices[0].message.content


def main():
    print("=" * 50)
    print("   🧠 Prompt Engineering Demo")
    print("=" * 50)

    persona = select_persona()
    print(f"\n✅ Persona selected: {persona['name']}")

    while True:
        print("\n" + "-" * 50)
        user_input = input("Ask something (or type 'exit' / 'switch'): ").strip()

        if user_input.lower() == "exit":
            print("Goodbye! 👋")
            break

        if user_input.lower() == "switch":
            persona = select_persona()
            print(f"✅ Switched to: {persona['name']}")
            continue

        if not user_input:
            continue

        # Chain-of-Thought option — learned today!
        use_cot = input("Show step-by-step reasoning? (yes/no): ").strip().lower() == "yes"

        print("\n💬 Answer:\n")
        answer = ask_ai(persona["prompt"], user_input, use_cot)
        print(answer)


if __name__ == "__main__":
    main()
```

### 🧪 Sample Run

```
==================================================
   🧠 Prompt Engineering Demo
==================================================

🤖 Select a Persona:
  [1] Python Tutor
  [2] Code Reviewer
  [3] Interview Coach
Enter number (default: 1): 2

✅ Persona selected: Code Reviewer

--------------------------------------------------
Ask something (or type 'exit' / 'switch'): Review this: for i in range(len(my_list)): print(my_list[i])
Show step-by-step reasoning? (yes/no): no

💬 Answer:

Issue: Iterating by index unnecessarily — this is not Pythonic.

Better approach:
for item in my_list:
    print(item)

If you need the index too:
for i, item in enumerate(my_list):
    print(i, item)
```

